# Leave blank so browsers use the same-origin /api proxy.
VITE_API_BASE_URL=
VITE_USE_MOCK_API=false

# Used by the Vercel /api proxy. Set this in Vercel to the Render API origin.
BACKEND_ORIGIN=https://your-api.example.com

API_PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
APP_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=lax
SESSION_TTL_DAYS=30
BETA_STARTING_CHIPS=10000
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_SYNC_SECRET=
FOOTBALL_SYNC_MAX_AGE_MINUTES=30
RESULTS_ENGINE_ENABLED=true
OPERATIONS_ENABLED=true
